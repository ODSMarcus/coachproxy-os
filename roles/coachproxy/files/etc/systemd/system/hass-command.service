[Unit]
Description=CoachProxy Home Assistant MQTT command bridge
After=network-online.target mosquitto.service
Wants=network-online.target
Requires=mosquitto.service

[Service]
Type=simple
User=pi
ExecStart=/usr/bin/perl -w /coachproxy/bin/hass_command.pl
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
