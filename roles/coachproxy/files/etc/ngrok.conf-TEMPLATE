version: "2"
authtoken: AUTHTOKEN
region: us
console_ui: false
update_check: false
tunnels:
  # With a custom subdomain the tunnel is bound to https only, so
  # basic-auth usernames/passwords are never sent over non-SSL. (The
  # ngrok v2 agent needed a second tunnel to port 8443 for this.)
  coachproxy:
    proto: http
    addr: 80
    basic_auth:
      - "USERNAME:PASSWORD"
    subdomain: SUBDOMAIN
    schemes: [SCHEMES]
    inspect: false
